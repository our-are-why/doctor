{
  // the webviews, in the browser: the DOM and Preact's JSX, no Node, no Bun.
  // Bun's bundler reads the JSX settings here too.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["**/*", "../shared/**/*"]
}
