{
  "name": "doctor",
  "publisher": "our-are-why",
  "displayName": "doctor",
  "description": "Read, edit and annotate documents beside an agent",
  "version": "0.1.0",
  "engines": { "vscode": "^1.140.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished", "onWebviewPanel:doctor.dashboard"],
  "contributes": {
    "customEditors": [
      {
        "viewType": "doctor.document",
        "displayName": "doctor document",
        "selector": [{ "filenamePattern": "*.doctor.json" }],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "doctor",
      "properties": {
        "doctor.dataFolder": {
          "type": "string",
          "default": ".doctor",
          "scope": "resource",
          "description": "Where doctor keeps a workspace folder's history and versions, relative to the folder."
        }
      }
    },
    "commands": [
      { "command": "doctor.newDocument", "title": "doctor: new document" },
      { "command": "doctor.openDashboard", "title": "doctor: open the task dashboard" }
    ]
  }
}
