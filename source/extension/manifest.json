{
  "name": "doctor",
  "publisher": "our-are-why",
  "displayName": "doctor",
  "description": "Read, edit and annotate documents beside an agent",
  "version": "0.1.0",
  "engines": { "vscode": "^1.140.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished", "onWebviewPanel:doctor.dashboard"],
  "contributes": {
    "customEditors": [
      {
        "viewType": "doctor.text",
        "displayName": "doctor editor",
        "selector": [{ "filenamePattern": "*.doctor.json" }],
        "priority": "default"
      },
      {
        "viewType": "doctor.document",
        "displayName": "doctor reading view",
        "selector": [{ "filenamePattern": "*.doctor.json" }],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "doctor",
      "properties": {
        "doctor.dataFolder": {
          "type": "string",
          "default": ".doctor",
          "scope": "resource",
          "description": "Where doctor keeps a workspace folder's history and versions, relative to the folder."
        }
      }
    },
    "commands": [
      { "command": "doctor.newDocument", "title": "doctor: new document" },
      { "command": "doctor.openDashboard", "title": "doctor: open the task dashboard" },
      { "command": "doctor.newTaskForFiles", "title": "doctor: quick task for these documents" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "doctor.newTaskForFiles", "when": "resourceFilename =~ /\\.doctor\\.json$/", "group": "doctor" }
      ],
      "commandPalette": [{ "command": "doctor.newTaskForFiles", "when": "false" }]
    }
  }
}
