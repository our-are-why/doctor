{
  "name": "doctor",
  "private": true,
  "type": "module",
  "scripts": {
    "makeCssTypes": "bun scripts/makeCssTypes.ts",
    "watchCssTypes": "bun scripts/makeCssTypes.ts --watch",
    "check": "bun run makeCssTypes && tsc -p tsconfig.json && tsc -p source/extension && tsc -p source/webview && tsc -p source/shared",
    "buildExtension": "bun run makeCssTypes && bun scripts/buildExtension.ts",
    "installExtension": "bun run makeCssTypes && bun scripts/installExtension.ts"
  },
  "dependencies": {
    "monaco-editor": "0.57.0",
    "preact": "11.1.0",
    "valibot": "1.5.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/vscode": "1.140.0",
    "@types/ws": "8.18.2",
    "lightningcss": "1.33.0",
    "typescript": "7.0.2"
  }
}
