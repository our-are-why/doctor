# code-server's data for this project: extensions and editor state
.coder-data/

# macOS Finder metadata
.DS_Store

# the packages bun install fetches; bun.lock records their versions
node_modules/

# what bun run buildExtension builds
build/

# documents to try doctor on, and their history: copies of samples/ to edit
# freely, kept by this repo's doctor.dataFolder setting
playground/

# CSS modules' declarations, which bun run makeCssTypes writes beside each
# stylesheet
*.module.d.css.ts
